# Скопируйте этот файл в .env и подставьте свои значения.
DATABASE_URL=postgresql+psycopg2://security_user:security_pass@db:5432/security_db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost

# Двухфакторная аутентификация: одноразовый код отправляется на почту
# через SMTP. Если оставить SMTP_HOST пустым, код не отправляется, а
# пишется в лог приложения (удобно для локальной разработки/тестов).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@school-security.local
SMTP_USE_TLS=true
