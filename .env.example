# Скопируйте в .env рядом с docker-compose.yml и при необходимости
# измените значения перед запуском `docker compose up --build`.
POSTGRES_DB=security_db
POSTGRES_USER=security_user
POSTGRES_PASSWORD=security_pass
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost,http://localhost:3000

# Двухфакторная аутентификация по почте. Если SMTP_HOST пуст, код не
# отправляется по сети, а пишется в лог контейнера backend
# (docker compose logs -f backend) — удобно для проверки без настройки
# реальной почты. Для настоящей отправки укажите данные вашего SMTP
# (например, Яндекс.Почты, Mail.ru или Gmail с паролем приложения).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@school-security.local
SMTP_USE_TLS=true
